{
  "name": "blacky0892/laravel-max-bot",
  "description": "Laravel package for MAX Bot API",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "max",
    "bot",
    "messenger",
    "api"
  ],
  "require": {
    "php": "^8.1|^8.2",
    "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/http": "^^9.0|10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.5|^11.0",
    "illuminate/routing": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/config": "^9.0|^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Blacky0892\\Max\\": "src/"
    }
  },
  "autoload-dev": {
    "classmap": [
      "tests"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Blacky0892\\Max\\MaxServiceProvider"
      ],
      "aliases": {
        "Max": "Blacky0892\\Max\\Facades\\Max"
      }
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}